{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export:root": "node scripts/check-data.mjs && node scripts/export-root.mjs",
    "export:check": "node scripts/export-root.mjs --dry-run",
    "photos": "node scripts/photos.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "favorites": "node scripts/favorites.mjs",
    "typecheck": "tsc --noEmit",
    "check:data": "node scripts/check-data.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:data && npm run build && npm run check:assets && npm run export:check && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "animejs": "^4.5.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
